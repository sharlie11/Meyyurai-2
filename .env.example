# PUBLIC CONFIGURATION (Exposed to the Vite Client)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_PROJECT_ID="your_project_ref"

# PRIVATE SERVER CONFIGURATION (Server-only Secrets)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"

# JWT and Admin Bypass Secret (Required for administrative functions & server-side operations)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Symmetric encryption key for PII contact numbers (AES-256 / pgcrypto)
ENCRYPTION_SECRET="your_custom_encryption_secret_key"

# AI PROVIDER CONFIGURATION (OpenRouter / Gemini / Ollama)
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL_NAME="gemini-3.1-flash-lite"

