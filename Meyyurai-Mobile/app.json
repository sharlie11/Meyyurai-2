{
  "expo": {
    "name": "Meyyurai",
    "slug": "meyyurai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meyyurai.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Meyyurai uses your location to attach exact GPS coordinates to emergency SOS alerts.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Meyyurai requires background location to share live transit updates with your trusted contacts when your phone is locked.",
        "NSLocationAlwaysUsageDescription": "Meyyurai requires background location for live emergency transit tracking.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "adjustResize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.meyyurai.app",
      "permissions": [
        "CALL_PHONE",
        "VIBRATE",
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
